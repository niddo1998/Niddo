# ── Auth0 ─────────────────────────────────────────────
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH0_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Usar la "service_role" key (NO la anon). Solo se usa en el backend.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Flask ──────────────────────────────────────────────
# Generá un secreto largo y random: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-secreto-largo

# ── Resend (envío de emails) ──────────────────────────
# Registrate en https://resend.com y creá una API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Email de origen (debe estar verificado en Resend)
RESEND_FROM_EMAIL=Niddo <noreply@tu-dominio.com>

# ── Groq Vision (extracción automática de comprobantes) ──
# Gratis, sin tarjeta. Obtené tu API key en https://console.groq.com
GROQ_API_KEY=tu_groq_api_key

# ── Notificaciones push al celular (Web Push) ─────────
# Un par de claves que identifica al servidor ante Google, Apple y Mozilla.
# Se generan UNA sola vez (cambiarlas invalida las suscripciones existentes):
#   python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives import serialization as s;k=ec.generate_private_key(ec.SECP256R1());b=lambda x:base64.urlsafe_b64encode(x).decode().rstrip('=');print('VAPID_PUBLIC_KEY='+b(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)));print('VAPID_PRIVATE_KEY='+b(k.private_numbers().private_value.to_bytes(32,'big')))"
# Sin estas variables la app funciona igual; sólo no ofrece activar las notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:soporte@niddo.app
